%% DOC-003 — Architektura systemu (diagram blokowy)
%% Wersja 2.0 | Status: roboczy | Właściciel: Paweł | Opracowanie: Claude | 2026-10-25
%% Dokument nadrzędny: proces.md
%% Historia: 2.0 (2026-10-25) MVP-A: tor AC-CDI zamiast VBG08H-E, akcelerometr AIS2IH zamiast BMI090L,
%%           KP464 zamiast BMP390, zasilanie wyłączane przez INH TJA1043, sprzętowy kill switch,
%%           usunięty TPS (Z1 obalone), wtrysk oznaczony jako B/C. Źródło: produkt.md rozdz. 3, 4, 6.
%%           2.3 (2026-11-09) blok AC-CDI: sprzetowy ogranicznik ladowania kondensatora (ECU-IGN-034)
%%           2.2 (2026-11-01) PMIC TPS65381A-Q1 zamiast przetwornic, TPS3430 i przelacznika obciazenia; ENDRV
%%           2.1 (2026-11-01) dwa uklady progowe kill switcha, klucz masy rozrusznika od przycisku START
%%           1.2 (2026-09-29) usuniety blok Quickshifter
%% LEGENDA: linia przerywana = tylko warianty B/C

flowchart LR

    subgraph MOTO["Motocykl - Beta 300 RR 2015 (MVP-A)"]
        BAT["Akumulator 12V kwasowy<br/>(stale podlaczony)"]
        EXC["Uzwojenie wzbudzajace<br/>statora"]
        VR["Czujnik obrotow walu<br/>VR lub Hall"]
        TW["Temp. cieczy"]
        TA["Temp. powietrza"]
        GEAR["Pozycja biegu<br/>MLX90316"]
        WS["Predkosc kola"]
        BTNM["Przycisk START"]
        KILL["Kill switch"]
        COIL["Cewka zaplonowa<br/>fabryczna RC01 IG5128"]
        INJ["Wtryskiwacze 1-2<br/>TPI / TBI"]
        FAN["Wentylator"]
        PUMP["Pompa paliwa"]
        LIGHT["Swiatla"]
        STR["Rozrusznik"]
    end

    subgraph ECU["ECU - STM32G474VET3"]
        CAN1["TJA1043<br/>INH steruje szynami"]
        PWR["PMIC TPS65381A-Q1<br/>VDD5, VDD3/5, VSOUT1<br/>watchdog, nadzor szyn"]
        COND["MAX9926<br/>kondycjoner VR"]
        CORE["Rdzen real-time<br/>HRTIM"]
        ACC["AIS2IH<br/>akcelerometr"]
        BARO["KP464<br/>cisnienie atm."]
        NTC["2x NTC<br/>temp. wnetrza"]
        NVM["W25Q64 8MB<br/>czarna skrzynka"]
        CMP["Komparator<br/>kill switcha"]
        THR["Prog tranzystorowy<br/>kill switcha"]
        SKEY["Klucz masy<br/>przekaznika rozrusznika"]
        CDI["Blok AC-CDI<br/>kondensator + tyrystor<br/>bramka impulsowa<br/>ogranicznik ladowania"]
        PROF["3x BTS7008-2EPA<br/>6 kanalow PROFET"]
        IDRV["TLE9104SH"]
        USB["USB-C"]
    end

    subgraph HMIBOX["HMI"]
        CAN2["TJA1043<br/>INH steruje szynami"]
        MCU2["STM32G0B1"]
        EVE["Riverdi RVT35<br/>EVE4 BT817Q"]
        FL2["Flash SPI<br/>zasoby graficzne"]
        TEMP2["Czujnik temp.<br/>ochrona LCD"]
    end

    BTNH["4 przyciski na kierownicy<br/>drabinka rezystorowa"]

    subgraph PC["Aplikacja desktop - Windows / .NET WPF"]
        APP["Mapy - live tuning<br/>logi - aktualizacja FW<br/>diagnostyka"]
    end

    BAT --> CAN1
    CAN1 -->|"INH -> IGN"| PWR
    BAT --> PWR
    BTNM -->|"WAKE"| CAN1
    BTNM --> CORE

    EXC ==>|"energia iskry"| CDI
    CDI ==> COIL
    CORE -->|"zbocze HRTIM"| CDI
    CDI -->|"napiecie wzbudzajacego<br/>przechwycenie wyzwolenia"| CORE

    KILL ==> CMP
    KILL ==> THR
    CMP ==>|"zezwolenie bramki AND"| CDI
    THR ==>|"zwarcie wzbudzajacego"| CDI
    CMP ==>|"blokada"| PROF
    THR ==>|"blokada"| SKEY
    BTNM ==>|"wcisniety"| SKEY
    SKEY ==> STR
    CMP -.-> IDRV

    VR --> COND --> CORE
    VR -.->|"zworka: Hall<br/>z pominieciem MAX9926"| CORE
    TW --> CORE
    TA --> CORE
    GEAR --> CORE
    WS --> CORE
    ACC --> CORE
    BARO --> CORE
    NTC --> CORE
    CORE <--> NVM
    CORE <-->|"SPI, watchdog"| PWR
    PWR ==>|"ENDRV"| CDI
    PWR ==>|"ENDRV"| PROF

    CORE -.-> IDRV -.-> INJ
    CORE --> PROF
    PROF --> FAN
    PROF -.-> PUMP
    PROF --> LIGHT
    PROF --> STR

    CORE <--> CAN1
    CAN1 <-->|"CAN bus"| CAN2
    CAN2 <--> MCU2
    MCU2 <--> EVE
    MCU2 <--> FL2
    TEMP2 --> MCU2
    BTNH -->|"DTM04-3P, WAKE"| MCU2

    CORE <--> USB
    USB <-->|"USB-C"| APP
